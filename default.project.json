{
  "name": "DeckEmpire",
  "globIgnorePaths": [
    "**/jest.config.lua",
    "**/*.spec.lua",
    "**/*.story.lua",
    "**/*.project.json",
    "**/CHANGELOG.md",
    "**/LICENSE.md",
    "**/README.md",
    "**/package.json",
    "**/deploy.nevermore.json",
    "**/.package-lock.json"
  ],
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "DeckGame": {
        "$className": "Folder",
        "Action": { "$className": "RemoteFunction" },
        "Changed": { "$className": "RemoteEvent" },
        "GetState": { "$className": "RemoteFunction" },
        "Leaderboard": { "$className": "RemoteFunction" },
        "Ping": { "$className": "RemoteFunction" },
        "Preferences": { "$className": "RemoteEvent" },
        "AvatarPreview": { "$path": "game/AvatarPreview.luau" },
        "ClientController": { "$path": "game/ClientController.luau" },
        "Config": { "$path": "game/Config.luau" },
        "App": { "$path": "game/App" },
        "EconomyService": { "$path": "game/EconomyService.luau" },
        "Fuzzy": { "$path": "game/Fuzzy.luau" },
        "Icons": { "$path": "game/Icons.luau" },
        "MusicManager": { "$path": "game/MusicManager.luau" },
        "NetworkService": { "$path": "game/NetworkService.luau" },
        "PreviewDirector": { "$path": "game/PreviewDirector.luau" },
        "RewardService": { "$path": "game/RewardService.luau" },
        "SearchIndex": { "$path": "game/SearchIndex.luau" },
        "ShopService": { "$path": "game/ShopService.luau" },
        "StateService": { "$path": "game/StateService.luau" },
        "Types": { "$path": "game/Types.luau" },
        "Validation": { "$path": "game/Validation.luau" }
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "DeckGameServer": { "$path": "game/Server.server.luau" },
      "DeckServer": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true,
        "LeaderboardService": { "$path": "game/LeaderboardService.luau" },
        "PersistenceService": { "$path": "game/PersistenceService.luau" },
        "ServerController": { "$path": "game/ServerController.luau" },
        "Throttle": { "$path": "game/Throttle.luau" },
        "SessionService": { "$path": "game/SessionService.luau" },
        "ActionService": { "$path": "game/ActionService.luau" },
        "ProductionService": { "$path": "game/ProductionService.luau" }
      },
      "DeckPackages": {
        "$className": "Folder",
        "$path": "ServerPackages"
      },
      "node_modules": {
        "$className": "Folder",
        "@quenty": {
          "$className": "Folder",
          "loader": { "$path": "node_modules/@quenty/loader/src" },
          "baseobject": { "$path": "node_modules/@quenty/baseobject/src" },
          "maid": { "$path": "node_modules/@quenty/maid/src" },
          "signal": { "$path": "node_modules/@quenty/signal/src" },
          "servicebag": { "$path": "node_modules/@quenty/servicebag/src" }
        }
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "DeckGameClient": { "$path": "game/Client.client.luau" }
      }
    }
  }
}
