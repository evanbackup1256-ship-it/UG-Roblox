{
  "name": "DeckEmpire",
  "globIgnorePaths": [
    "**/jest.config.lua",
    "**/*.spec.lua",
    "**/*.story.lua",
    "**/*.project.json",
    "**/CHANGELOG.md",
    "**/LICENSE.md",
    "**/README.md",
    "**/package.json",
    "**/deploy.nevermore.json",
    "**/.package-lock.json"
  ],
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "DeckGame": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true,
        "AvatarPreview": { "$path": "game/AvatarPreview.luau" },
        "ClientController": { "$path": "game/ClientController.luau" },
        "Config": { "$path": "game/Config.luau" },
        "DesignKit": { "$path": "game/DesignKit.luau" },
        "EconomyService": { "$path": "game/EconomyService.luau" },
        "Icons": { "$path": "game/Icons.luau" },
        "InterfaceShared": { "$path": "game/InterfaceShared.luau" },
        "InterfacePageContracts": { "$path": "game/InterfacePageContracts.luau" },
        "InterfacePageEvents": { "$path": "game/InterfacePageEvents.luau" },
        "InterfacePageInfrastructure": { "$path": "game/InterfacePageInfrastructure.luau" },
        "InterfacePageLeaderboard": { "$path": "game/InterfacePageLeaderboard.luau" },
        "InterfacePageModules": { "$path": "game/InterfacePageModules.luau" },
        "InterfacePageOperations": { "$path": "game/InterfacePageOperations.luau" },
        "InterfacePageOverview": { "$path": "game/InterfacePageOverview.luau" },
        "InterfacePagePrestige": { "$path": "game/InterfacePagePrestige.luau" },
        "InterfacePageResearch": { "$path": "game/InterfacePageResearch.luau" },
        "InterfacePageRewards": { "$path": "game/InterfacePageRewards.luau" },
        "InterfacePageSettings": { "$path": "game/InterfacePageSettings.luau" },
        "InterfacePageShop": { "$path": "game/InterfacePageShop.luau" },
        "MotionService": { "$path": "game/MotionService.luau" },
        "MusicManager": { "$path": "game/MusicManager.luau" },
        "NetworkService": { "$path": "game/NetworkService.luau" },
        "PreviewDirector": { "$path": "game/PreviewDirector.luau" },
        "RewardService": { "$path": "game/RewardService.luau" },
        "Settings": { "$path": "game/Settings.luau" },
        "SettingsController": { "$path": "game/SettingsController.luau" },
        "ShopService": { "$path": "game/ShopService.luau" },
        "StateService": { "$path": "game/StateService.luau" },
        "Types": { "$path": "game/Types.luau" },
        "UIPrimitives": { "$path": "game/UIPrimitives.luau" },
        "Validation": { "$path": "game/Validation.luau" },
        "InterfaceController": { "$path": "game/InterfaceController.luau" }
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "DeckGameServer": { "$path": "game/Server.server.luau" },
      "DeckServer": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true,
        "LeaderboardService": { "$path": "game/LeaderboardService.luau" },
        "PersistenceService": { "$path": "game/PersistenceService.luau" },
        "ServerController": { "$path": "game/ServerController.luau" },
        "Throttle": { "$path": "game/Throttle.luau" },
        "SessionService": { "$path": "game/SessionService.luau" },
        "ActionService": { "$path": "game/ActionService.luau" },
        "ProductionService": { "$path": "game/ProductionService.luau" }
      },
      "DeckPackages": {
        "$className": "Folder",
        "$path": "ServerPackages"
      },
      "node_modules": {
        "$className": "Folder",
        "@quenty": {
          "$className": "Folder",
          "loader": { "$path": "node_modules/@quenty/loader/src" },
          "baseobject": { "$path": "node_modules/@quenty/baseobject/src" },
          "maid": { "$path": "node_modules/@quenty/maid/src" },
          "signal": { "$path": "node_modules/@quenty/signal/src" },
          "servicebag": { "$path": "node_modules/@quenty/servicebag/src" }
        }
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "DeckGameClient": { "$path": "game/Client.client.luau" }
      }
    }
  }
}
